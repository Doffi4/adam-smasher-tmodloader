Mods: {
	AdamSmasher: {
		Items: {
			ArasakaBeacon: {
				DisplayName: Маяк «Арасака»
				Tooltip:
					'''
					Призывает Адама Смэшера; не расходуется
					Нельзя использовать, пока активен любой босс
					Рецепт: 5 слитков тени, 25 загадочных микросхем и 25 сомнительных обшивок у кузни Дрэйдона
					'''
			}

			AnnihilationProtocol: {
				DisplayName: Протокол уничтожения
				Tooltip:
					'''
					Стреляет парами самонаводящихся ракет с широкими взрывами
					Удерживайте ПКМ 1–2 секунды для заряда тяжёлого плазменного выстрела
					Заряд дополнительно расходует ману каждые 1/3 секунды с учётом вашей экипировки
					Выстрел оставляет плазменное поле; перезарядка после выстрела — 5 секунд
					Машина «Арасаки», созданная с единственной целью
					'''
			}

			ArasakaMantisBlades: {
				DisplayName: Клинки богомола «Арасака»
				Tooltip:
					'''
					Чередует широкие разрезы; третья атака скрещивает клинки и наносит на 50% больше урона
					Удерживайте ЛКМ: за 2 секунды урон разрезов растёт на 50%, а дальность — со 175 до 315
					Отпускание ЛКМ, ПКМ или смена оружия сбрасывают разгон
					ПКМ бросает оба клинка к курсору, после чего они возвращаются
					Смена оружия или пауза между атаками сбрасывает комбо
					'''
			}

			SmasherBag: {
				DisplayName: Мешок с сокровищами (Адам Смэшер)
				Tooltip:
					'''
					Нажмите ПКМ, чтобы открыть
					Содержит ровно одно оружие: «Протокол уничтожения» или клинки богомола «Арасака», с шансом 50% каждое
					Выбор в каждом мешке независим
					'''
			}
		}

		NPCs.AdamSmasherBoss.DisplayName: Адам Смэшер
		BossChecklist.SpawnInfo: Используйте нерасходуемый маяк «Арасака», пока другие боссы не активны. Рецепт у кузни Дрэйдона: 5 слитков тени, 25 загадочных микросхем и 25 сомнительных обшивок.

		Projectiles: {
			BossBullet.DisplayName: Пуля Смэшера
			BossRocket.DisplayName: Ракета Смэшера
			PlasmaCharge.DisplayName: Тяжёлый плазменный выстрел
			PlasmaField.DisplayName: Плазменное поле
			RocketExplosion.DisplayName: Взрыв ракеты
			SmartRocket.DisplayName: Самонаводящаяся ракета
			MantisSlash.DisplayName: Разрез богомола
			MantisThrow.DisplayName: Возвращающийся клинок богомола
			// BossBlast.DisplayName: Boss Blast
		}
	}
}
